# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel (Settings > Environment Variables).

# Banco (Prisma Postgres) — a integração da Vercel cria estas variáveis automaticamente
DATABASE_URL_POOLED="postgres://USUARIO:SENHA@pooled.db.prisma.io:5432/postgres?sslmode=require"
POSTGRES_URL="postgres://USUARIO:SENHA@db.prisma.io:5432/postgres?sslmode=require"

# Login do painel /admin (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere com: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
